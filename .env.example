# Kişisel Finans Ajanı — sırlar şablonu.
# Bu dosyayı `.env` olarak kopyala ve doldur (lokal test için).
# ÜRETİMDE bu değerler GitHub Secrets'a girilir; .env repoya ASLA commit'lenmez.

# --- Anthropic (sabah turu ajanı) ---
ANTHROPIC_API_KEY=

# --- ABD hisse fiyatı (Twelve Data ücretsiz Basic; 8 çağrı/dk, 800/gün) ---
TWELVEDATA_API_KEY=

# --- TÜFE + TCMB makro serileri (ücretsiz EVDS anahtarı: https://evds3.tcmb.gov.tr) ---
# §2.6 kıyas ölçütü (TÜFE) bunu ister. Yoksa TÜFE bozulmadan atlanır ama kıyas eksik kalır.
EVDS_API_KEY=

# --- Mail (Gmail için SMTP + uygulama şifresi) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
