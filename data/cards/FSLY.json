  "story": {
    "analyst_narrative": "13 analist, Tut/Al bölünmüş, hedef 13-32 $, ortalama ~25-27 $. Boğalar marj+NRR, ayılar konsantrasyon ve Cloudflare.",
    "author": "claude",
    "bear_case": [
      "İlk 10 müşteri gelirin %26-34'ü; kullanım bazlı model oynak",
      "Cloudflare karşısında yapısal pay kaybı riski",
      "GAAP zararı, yüksek SBC; Q2'nin bir kısmı spor etkinliği trafiği (tekrarlamayabilir)"
    ],
    "bull_case": [
      "LTM NRR beş çeyrek üst üste iyileşti: %100→%117",
      "Güvenlik +%43 (gelirin %23'ü), Compute +%69; non-GAAP brüt marj rekor %65,8",
      "Tam yıl kılavuzu iki kez yükseltildi; 40 Kuralı ~44 ilk kez sağlıklı"
